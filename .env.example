# KRIS Guard settings. Copy this file to ".env" and fill it in.
# NEVER commit .env or share it: it contains secrets.

# --- Secrets (required) -------------------------------------------------------
# Generate each one with:   openssl rand -hex 32
# They must be different from each other and at least 32 characters.

# Signs every audit-log entry and checkpoint. If it leaks, audit entries can be forged.
KRIS_GUARD_AUDIT_KEY=

# Protects stored client keys (and later, admin sessions).
# Changing it makes every existing client key stop working.
KRIS_GUARD_SECRET=

# --- AI provider keys (KRIS's own) --------------------------------------------
# Clients never see these. Leave one empty if you do not use that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Largest request accepted, in bytes (default 5 MB).
# MAX_BODY_BYTES=5242880

# How long to wait for the provider, in milliseconds (default 2 minutes).
# UPSTREAM_TIMEOUT_MS=120000

# Log detail: fatal, error, warn, info, debug, silent.
# LOG_LEVEL=info

# --- Optional: PostgreSQL instead of SQLite -----------------------------------
# POSTGRES_PASSWORD=choose-a-long-random-password
# DATABASE_URL=postgres://krisguard:choose-a-long-random-password@postgres:5432/krisguard
