{
  "name": "kris-guard",
  "version": "0.1.0",
  "description": "Self-hosted AI safety gateway: hides personal data, enforces client rules, keeps a tamper-evident audit log.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "audit:deps": "npm audit --audit-level=low"
  },
  "bin": {
    "kris-guard": "dist/cli.js"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
